# Core LLM settings (Ollama-First Local Setup)
MODEL_PROVIDER=ollama
MODEL_NAMES=["llama3.2"]
MODEL_BASE_URL=http://localhost:11434
EMBEDDINGS_MODEL_NAME=nomic-embed-text
EMBEDDINGS_BASE_URL=http://localhost:11434

# External Tool API Keys (Optional)
TAVILY_API_KEY=
OPENAI_API_KEY=

# Authentication and JWT Token Setup
TOKEN_BEARER_URL=/api/v1/auth/login
JWT_SECRET=f7410f8d0107749f066a06b360288d1d92bc8f9c23e3326d069793743d4992f2
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY_MINS=1500
REFRESH_TOKEN_EXPIRY_DAYS=1

# PostgreSQL + pgvector Storage
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=test
POSTGRES_DATABASE=langgraph_db
PGVECTOR_COLLECTION_NAME=my_collection

# Memory RAG Cognitive Settings (Chapters 4, 6, 7, 10, 14)
MEMORY_DECAY_RATE=0.05
MEMORY_MAX_AGE_DAYS=30
MEMORY_CONSOLIDATION_INTERVAL=10
MEMORY_IMPORTANCE_THRESHOLD=0.3

# Frontend Lab Suite config
BACKEND_BASE_URL=http://127.0.0.1:8000/api/v1

# ============================================================================
#  Reasoning layer  (Agentic AI Reasoning Model System Design)
# ============================================================================
# Models. The critic is deliberately a DIFFERENT, smaller model: a verifier
# that shares the generator's failure modes adds cost and no signal (Ch.7).
REASONER_MODEL=qwen2.5:3b
CRITIC_MODEL=qwen3:1.7b
VISION_MODEL=qwen2.5-vl:3b
# Leave empty to use the LLM reranker; set to a cross-encoder id (e.g.
# BAAI/bge-reranker-base) after installing requirements-optional.txt.
RERANKER_MODEL=

# Retrieval (Ch.6)
RETRIEVAL_MAX_HOPS=3
RETRIEVAL_RERANK_TO=6
RERANK_SCORE_FLOOR=0.0
INDEX_VERSION=v1

# Graph channel (Ch.6)
GRAPH_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=reasoning
NEO4J_DATABASE=neo4j

# Tool sandboxes (Ch.5). These are enforced by the runtime and the database,
# never by asking the model nicely.
SQL_STATEMENT_TIMEOUT_MS=8000
SANDBOX_WALL_S=5.0
SANDBOX_MEMORY_MB=256
REPLICA_HOST=
REPLICA_USER=reasoning_reader
REPLICA_PASSWORD=reasoning_reader

# Test-time compute policy (Ch.8)
DEFAULT_TIER=standard
ADAPTIVE_ROUTING=true
EARLY_STOP_PATIENCE=2
SELF_CONSISTENCY_N=5

# Operational (Ch.10)
# LABS_ENABLED exposes internals the production API deliberately hides.
# MUST be false in any deployment that is not a local reading environment.
LABS_ENABLED=true
TRACE_RETENTION_DAYS=30
